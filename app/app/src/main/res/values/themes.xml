<resources>
    <style name="Theme.Konecto" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/konecto_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Konecto.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/konecto_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_k</item>
        <item name="postSplashScreenTheme">@style/Theme.Konecto</item>
    </style>
</resources>
