# --- Database (docker compose) ---
POSTGRES_USER=konecto
POSTGRES_PASSWORD=konecto
POSTGRES_DB=konecto
POSTGRES_PORT=5432
# Host port for the API (http://localhost:${BACKEND_PORT}/docs)
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://konecto:konecto@localhost:5432/konecto

# --- PDF -> Markdown extraction (Google AI Studio, free tier) ---
GOOGLE_API_KEY=your-google-ai-studio-key
EXTRACTION_MODEL=gemini-3.6-flash

# --- OpenRouter (LLM + embeddings) ---
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=anthropic/claude-haiku-5.5
# EMBEDDING_PROVIDER: openrouter | google (google uses GOOGLE_API_KEY, e.g. EMBEDDING_MODEL=models/gemini-embedding-001)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# --- Agent ---
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=5
AGENT_TIMEOUT_S=60
HISTORY_TURNS=8

# --- API / auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
DEBUG_API_ENABLED=true
CORS_ORIGINS=*
